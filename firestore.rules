rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUtdDomain() {
      return isAuthenticated() 
        && request.auth.token.email != null 
        && request.auth.token.email.matches('.*@utd[.]ac[.]th$');
    }

    function isAdmin() {
      return isUtdDomain() && (request.auth.token.role == 'admin');
    }

    // Main App Configuration & Entity Data
    match /apps/{appId} {
      allow read: if true;
      allow write: if isAuthenticated();

      // Subcollection: Schedule Entries (1 doc per schedule slot)
      match /scheduleEntries/{entryId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }

      // Subcollection: Activity Logs (1 doc per log entry)
      match /activityLogs/{logId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update, delete: if isAdmin() || isUtdDomain();
      }

      // Subcollection: System Health & Error Logs
      match /errors/{errorId} {
        allow read, write: if true;
      }
    }
  }
}
